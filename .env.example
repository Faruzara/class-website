# ============================================
# SUPABASE — ambil dari dashboard supabase.com
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...  # JANGAN expose ke client!

# ============================================
# MEDIA STORAGE - Supabase (default) / Cloudinary
# ============================================
# Ganti menjadi cloudinary setelah ketiga credential di bawah terisi.
MEDIA_STORAGE_PROVIDER=supabase
CLOUDINARY_CLOUD_NAME=nama_cloud_kamu
CLOUDINARY_API_KEY=api_key_kamu
CLOUDINARY_API_SECRET=api_secret_kamu  # JANGAN expose ke client!
CLOUDINARY_ENV_FOLDER=dev

# ============================================
# AUTH — ganti dengan secret yang kuat
# ============================================
# Secret untuk signing JWT session token
JWT_SECRET=ganti_dengan_random_string_panjang_minimal_32_karakter

# Master key owner — HANYA kamu yang tahu ini
# Generate dengan: openssl rand -hex 32
OWNER_MASTER_KEY=ganti_dengan_random_hex_64_karakter

# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_NAME=XI TP2
NEXT_PUBLIC_CLASS_NAME=XI Teknik Pemesinan 2
NEXT_PUBLIC_SCHOOL_NAME=SMKN Jambu
# Fallback homepage. Data yang tersimpan melalui dashboard tetap diprioritaskan.
# URL gambar boleh berasal dari provider media yang sedang aktif.
NEXT_PUBLIC_HERO_IMAGE_URL=
NEXT_PUBLIC_ABOUT_CLASS=Kelas yang tumbuh lewat ketelitian, kerja sama, dan semangat belajar di bidang teknik pemesinan.
